# LonePouch Voice Agent — Environment Variables
# Copy to .env and fill in your keys

# Resend API Key (for email delivery)
RESEND_API_KEY=re_xxxxxxxxxxxx

# From email address for inquiries
FROM_EMAIL="LonePouch Voice Agent <inquiries@lonepouches.com>"

# Routing email addresses
SUPPORT_EMAIL=support@lonepouches.com
SALES_EMAIL=sales@lonepouches.com

# Supabase (for caller memory tools)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx